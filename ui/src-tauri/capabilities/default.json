{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Capability for the main TermX window",
  "windows": [
    "main",
    "aux-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "allow-bootstrap-host",
    "allow-read-app-file",
    "allow-write-app-file",
    "allow-plugin-spawn",
    "allow-plugin-read-runtime",
    "allow-plugin-read-manifest",
    "allow-plugin-probe",
    "allow-plugin-stderr-tail",
    "allow-read-ssh-config",
    "allow-protect-secret",
    "allow-unprotect-secret",
    "allow-ssh-probe",
    "allow-list-dirs",
    "allow-open-folder",
    "allow-list-llm-sessions",
    "allow-generate-session-note",
    "allow-generate-session-bundle",
    "allow-list-session-outputs",
    "allow-dismiss-session-output",
    "allow-list-session-artifacts",
    "allow-read-text-file",
    "allow-read-transcript-window",
    "allow-search-transcript",
    "allow-chat-feed-open",
    "allow-chat-feed-poll",
    "allow-chat-feed-close",
    "dialog:allow-open"
  ]
}
